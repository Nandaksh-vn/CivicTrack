# =============================================================================
# CivicTrack - Environment Variables Contract
# Copy this file to .env and replace every CHANGE_ME value before starting.
# .env is git-ignored; .env.example contains no real secrets.
# =============================================================================

# -- Database ----------------------------------------------------------------
# SQLAlchemy DSN used by the API and worker (PyMySQL sync driver).
DATABASE_URL=mysql+pymysql://civictrack:civictrack_pass@db:3306/civictrack

# Consumed by the MySQL container.
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=civictrack
MYSQL_USER=civictrack
MYSQL_PASSWORD=civictrack_pass

# -- Application -------------------------------------------------------------
# development | demo | staging | production
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# -- Authentication ----------------------------------------------------------
# Development placeholder works locally; production refuses it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_32_byte_secret_before_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# -- Escalation / SLA --------------------------------------------------------
# Production default is seven calendar days. Do not change for production.
ESCALATION_WINDOW_MINUTES=10080
# Only true for local demos with a shortened window.
ALLOW_DEMO_ESCALATION=false
# How often the worker checks for overdue complaints.
# Compatibility alias accepted by the app: ESCALATION_INTERVAL_SECONDS.
ESCALATION_CHECK_SECONDS=60
ESCALATION_BATCH_SIZE=100

# -- Internal API ------------------------------------------------------------
# Required by token-protected /api/v1/internal/* endpoints.
# Compatibility alias accepted by the app: INTERNAL_API_TOKEN.
INTERNAL_TRIGGER_TOKEN=CHANGE_ME_generate_a_32_byte_internal_token

# -- Uploads -----------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_COMPLAINT=10
MAX_IMAGES_PER_SUBMISSION=3
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# -- Seed data / P1 feature flags -------------------------------------------
SEED_DEMO_DATA=false
SEED_PASSWORD=Demo@12345
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ENABLE_AI_FEATURES=false

# -- Frontend build arguments ------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_AI=false
VITE_ENABLE_MAP=false
VITE_ENABLE_FEEDBACK=false
